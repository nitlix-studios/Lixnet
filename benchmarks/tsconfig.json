{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["esnext", "dom", "dom.iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "types": ["bun"],
        "paths": {
            // Benchmarks run against the built package (what users install), not src/.
            "lixnet": ["../dist/exports"]
        }
    },
    "exclude": ["node_modules", "types/.generated", "bundle/.out"]
}
